---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import MainLayout from './MainLayout.astro';
import { makeBanner } from '../lib/banners';

type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { title, description, pubDate, updatedDate, readTime, tags, accent, pattern, id } =
	Astro.props;
const banner = makeBanner(pattern, accent, id);
---

<MainLayout title={title} description={description}>
	<article class="post">
		<div class="container container--narrow">
			<div class="article-banner">
				<Fragment set:html={banner} />
			</div>
			<header class="article-head">
				<div class="article-meta">
					{tags.map((t) => <span class="tag">{t}</span>)}
					<span><FormattedDate date={pubDate} /></span>
					<span class="sep">·</span>
					<span>{readTime} min read</span>
					{
						updatedDate && (
							<>
								<span class="sep">·</span>
								<span class="last-updated-on">
									updated <FormattedDate date={updatedDate} />
								</span>
							</>
						)
					}
				</div>
				<h1 class="article-title">{title}</h1>
				<p class="article-desc">{description}</p>
			</header>
			<div class="prose">
				<slot />
			</div>
		</div>
	</article>
</MainLayout>
