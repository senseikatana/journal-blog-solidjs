---
import MainLayout from '../../layouts/MainLayout.astro';
import { privateDocs } from '../../data/docs';
import { resume } from '../../data/resume';
---

<MainLayout
	title={`Private documents — ${resume.name}`}
	description="Private PDFs shared on request. Each document requires the access code I shared with you."
>
	<section class="section page-hero">
		<div class="container container--narrow">
			<div class="section-head">
				<div>
					<h2 class="section-title">
						<span class="index">[ docs ]</span>
						Private <em>documents</em>
					</h2>
				</div>
				<p class="section-desc">
					These files are not listed anywhere and their URLs are never exposed.
					Enter the access code I shared with you to download.
				</p>
			</div>

			<div class="resume-cards">
				{
					privateDocs.map((doc) => (
						<div class="resume-card">
							<div class="resume-card-top">
								<span class="resume-card-kicker">[ doc ]</span>
								<svg
									width="14"
									height="14"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="doc-lock"
									><rect x="3" y="11" width="18" height="11" rx="2"></rect
									><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
								>
							</div>
							<h4 class="resume-card-role">{doc.label}</h4>
							<p class="resume-card-desc">{doc.desc}</p>
							<form class="doc-form" data-doc={doc.id}>
								<div class="doc-row">
									<input
										class="doc-code"
										type="password"
										placeholder="access code"
										autocomplete="off"
										aria-label="Access code"
									/>
									<button class="btn btn-primary doc-btn" type="submit">
										download
									</button>
								</div>
								<span class="doc-status" aria-live="polite"></span>
							</form>
						</div>
					))
				}
			</div>

			<p class="resume-lang" style="margin-top: 24px">
				Need a document? <a href={`mailto:${resume.contact.email}`}>Ask for it</a>
				and I'll send you the code.
			</p>
		</div>
	</section>
</MainLayout>

<script>
	document.querySelectorAll<HTMLFormElement>('.doc-form').forEach((form) => {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const docId = form.getAttribute('data-doc');
			const input = form.querySelector<HTMLInputElement>('.doc-code');
			const status = form.querySelector<HTMLElement>('.doc-status');
			if (!status) return;

			const token = input?.value.trim() ?? '';
			if (!token) {
				status.textContent = 'enter the access code';
				return;
			}

			status.textContent = 'checking…';
			try {
				const res = await fetch(`/api/download/${docId}`, {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ token }),
				});
				if (!res.ok) {
					status.textContent =
						res.status === 401 ? 'invalid access code' : 'something went wrong';
					return;
				}

				const blob = await res.blob();
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = `${docId}.pdf`;
				document.body.appendChild(a);
				a.click();
				a.remove();
				URL.revokeObjectURL(url);
				status.textContent = 'download started';
			} catch {
				status.textContent = 'network error';
			}
		});
	});
</script>
